<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins restore to nuget.org, regardless of any other package source configured on the
    machine running the build. Without this, an extra local or private feed registered
    for an unrelated project on the same machine can silently shadow a published package
    of the same id/version with a stale local build, and restore never reports the
    substitution.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
